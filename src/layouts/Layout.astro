---
import { Font } from "astro:assets";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

/** A share image travels with its own dimensions, so the three cannot disagree. */
export interface ShareImage {
  src: string;
  width: number;
  height: number;
}

export interface Props {
  title?: string;
  description?: string;
  image?: ShareImage;
  type?: "website" | "article";
  canonical?: string;
  reading?: boolean;
  /** Class for the <main> this layout renders. The reading shell renders its own. */
  mainClass?: string;
}

const defaultTitle = "Frankie Ramirez - Staff Software Engineer, Frontend Architecture and Design Systems";
const defaultDescription =
  "Frankie Ramirez is a Staff Software Engineer who leads frontend architecture and design systems, with an engineering practice built around AI-assisted workflows.";
const defaultImage: ShareImage = { src: "/og.png", width: 1200, height: 630 };
const {
  title = defaultTitle,
  description = defaultDescription,
  image = defaultImage,
  type = "website",
  canonical,
  reading = false,
  mainClass,
} = Astro.props;

const siteHref = Astro.site?.href ?? "https://frankieramirez.com/";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteHref).href;
const ogImage = new URL(image.src, siteHref).href;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Frankie Ramirez",
  jobTitle: "Staff Software Engineer",
  description:
    "Staff Software Engineer and frontend architect who leads design systems and builds with AI-assisted engineering workflows",
  url: siteHref,
  email: "mailto:hello@frankieramirez.com",
  sameAs: [
    "https://www.linkedin.com/in/frankieramirez",
    "https://x.com/frankieramirez",
    "https://github.com/frankieramirez",
    "https://bsky.app/profile/frankieramirez.bsky.social",
    "https://mastodon.social/@frankieramirez",
  ],
  address: {
    "@type": "PostalAddress",
    addressRegion: "New Jersey",
    addressCountry: "US",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Frankie Ramirez" />
    {/* Kept in step with --color-canvas-50 in styles/tokens/primitives.css by
        hand: a meta tag cannot read a custom property. */}
    <meta name="theme-color" content="#FAFAF9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060605" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:site_name" content="Frankie Ramirez" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@frankieramirez" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  </head>
  <body class:list={{ reading }}>
    <a href="#main" class="skip-link">Skip to main content</a>
    {reading ? (
      /* The reading shell puts <main> inside its own grid, beside the section
         nav, so pages/blog/[...id].astro declares that one itself. */
      <slot />
    ) : (
      <>
        <Header />
        <main id="main" class={mainClass} tabindex="-1">
          <slot />
        </main>
        <Footer />
      </>
    )}

    <script>
      import { initPointerSpotlights } from "@/scripts/pointer-spotlight";

      initPointerSpotlights();
    </script>
  </body>
</html>
