---
import Layout from '@/layouts/Layout.astro';
import { formatPostDate, getPublishedPosts } from '@/lib/blog';
import '@/styles/components/blog.css';

const posts = await getPublishedPosts({ includeDrafts: true });
---
<Layout
  title="Blog | Frankie Ramirez"
  description="Frankie Ramirez writes about AI coding workflows, self-hosting, frontend architecture, and design systems."
  mainClass="blog-index wrap"
>
  <header class="blog-intro">
    <p class="blog-eyebrow">Notes & observations</p>
    <h1>Blog</h1>
    <p>On AI coding workflows, self-hosting, frontend architecture, and design systems.</p>
  </header>
  <div class="blog-posts">
    {posts.map((post) => (
      <a class="blog-post" href={`/blog/${post.id}/`}>
        <span class="blog-eyebrow">{post.data.draft ? 'Sample · draft preview' : formatPostDate(post.data.date)}</span>
        <div><h2>{post.data.title}</h2><p>{post.data.description}</p></div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
    {posts.length === 0 && <p class="blog-empty">The first article is on its way. Check back soon.</p>}
  </div>
</Layout>
