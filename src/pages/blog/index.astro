---
import Layout from '@/layouts/Layout.astro';
import { formatPostDate, getPublishedPosts, readingMinutes } from '@/lib/blog';

const posts = await getPublishedPosts({ includeDrafts: true });
---
<Layout
  title="Writing | Frankie Ramirez"
  description="Frankie Ramirez writes about building interfaces and the decisions behind them, along with experiments in AI-assisted development and self-hosting."
  mainClass="wrap writing"
>
  <header class="intro">
    <h1>Writing</h1>
    <p class="intro-lede">Notes on building interfaces and the decisions behind them, plus experiments with AI agents and self-hosting.</p>
    <a class="text-link" href="/rss.xml">Follow via RSS</a>
  </header>
  <ol class="post-list" role="list">
    {posts.map((post) => (
      <li>
        <a class="post-row" href={`/blog/${post.id}/`}>
          <p class="label">
            {post.data.draft ? 'Draft preview' : <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>}
            <span aria-hidden="true"> · </span>{readingMinutes(post.body)} min read
          </p>
          <h2>{post.data.title}</h2>
          <p class="post-description">{post.data.description}</p>
        </a>
      </li>
    ))}
  </ol>
  {posts.length === 0 && <p class="intro-lede">The first article is on its way. Check back soon.</p>}
</Layout>
