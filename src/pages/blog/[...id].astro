---
import { render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { formatPostDate, getPublishedPosts, readingMinutes, type BlogPost } from '@/lib/blog';
import { externalAttrs } from '@/lib/links';

export async function getStaticPaths() {
  const posts = await getPublishedPosts({ includeDrafts: true });
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props { post: BlogPost }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3);
const minutes = readingMinutes(post.body);
const publishedPosts = await getPublishedPosts();
const relatedPosts = publishedPosts.filter((candidate) => candidate.id !== post.id && post.data.related.some(({ id }) => id === candidate.id));
---
<Layout
  type="article"
  title={`${post.data.title} | Frankie Ramirez`}
  description={post.data.description}
  image={post.data.image ? { src: post.data.image, width: 1200, height: 480 } : undefined}
  article={{ headline: post.data.title, published: post.data.date, updated: post.data.updated }}
  mainClass="wrap reader"
>
  <aside class="reader-sidebar">
    <a class="reader-back" href="/blog/"><span aria-hidden="true">←</span> All writing</a>
    {sections.length > 0 && <nav aria-label="Article sections" class="reader-toc">
      <p class="label">On this page</p>
      <ol role="list">{sections.map((section) => <li class:list={{ nested: section.depth === 3 }}><a href={`#${section.slug}`} data-section-link>{section.text}</a></li>)}</ol>
    </nav>}
  </aside>
  <article class="reader-main">
    <header class="article-header">
      <p class="label">
        {post.data.draft ? 'Sample article · unpublished draft' : <time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time>}
        <span aria-hidden="true"> · </span>{minutes} min read
        {post.data.updated && <><span aria-hidden="true"> · </span>Updated <time datetime={post.data.updated.toISOString()}>{formatPostDate(post.data.updated)}</time></>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="article-deck">{post.data.description}</p>
      {post.data.source && <a class="text-link article-source" href={post.data.source} {...externalAttrs(post.data.source)}>Originally published on X <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>}
    </header>
    {sections.length > 0 && <details class="reader-mobile-contents">
      <summary class="label">On this page</summary>
      <nav aria-label="Article sections" class="reader-toc">
        <ol role="list">{sections.map((section) => <li class:list={{ nested: section.depth === 3 }}><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
      </nav>
    </details>}
    {post.data.image && <img class="article-cover" src={post.data.image} alt={post.data.imageAlt ?? ''} width="1200" height="480" decoding="async" />}
    <div class="article-body"><Content /></div>
    <footer class="article-end">
      {relatedPosts.length > 0 && <nav class="article-related" aria-label="Related reading">
        <h2 class="label">Related reading</h2>
        <ul role="list">{relatedPosts.map((related) => <li><a href={`/blog/${related.id}/`}>{related.data.title}</a></li>)}</ul>
      </nav>}
      <a class="reader-back" href="/blog/"><span aria-hidden="true">←</span> All writing</a>
    </footer>
  </article>
</Layout>
<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
  const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
  let queued = false;
  function updateSection() {
    let active = -1;
    sections.forEach((section, index) => {
      if (section && section.getBoundingClientRect().top <= 160) active = index;
    });
    links.forEach((link, index) => {
      if (index === active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    queued = false;
  }
  window.addEventListener('scroll', () => {
    if (!queued) { queued = true; requestAnimationFrame(updateSection); }
  }, { passive: true });
  updateSection();
</script>
