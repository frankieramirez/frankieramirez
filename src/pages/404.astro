---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found | Frankie Ramirez" description="That page does not exist on frankieramirez.com.">
  <section class="wrap intro" aria-labelledby="not-found-title">
    <p class="label">404</p>
    <h1 id="not-found-title">That page doesn’t exist.</h1>
    <p class="intro-lede">
      It may have moved when the site was redesigned. Everything that’s left is on the homepage or in the writing.
    </p>
    <nav class="intro-links" aria-label="Recovery links">
      <a href="/">Homepage</a>
      <a href="/blog/">All writing</a>
    </nav>
  </section>
</Layout>
