---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page not found - Frankie Ramirez" description="That page does not exist on frankieramirez.com.">
  <main id="main" tabindex="-1">
    <section class="section" aria-labelledby="not-found-title">
      <div class="wrap section-grid">
        <div class="section-label">404</div>
        <div class="section-body">
          <div class="section-heading">
            <h1 id="not-found-title">That page does not exist.</h1>
            <p>
              This site is a single page. The work, the principles, and the contact details all live on the home page.
            </p>
          </div>
          <nav class="not-found-links" aria-label="Recovery links">
            <a href="/">Home</a>
            <a href="/#work">Work</a>
            <a href="/#contact">Contact</a>
          </nav>
        </div>
      </div>
    </section>
  </main>
</Layout>
