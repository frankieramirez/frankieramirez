<picture class="brand-mark" aria-hidden="true">
  <source srcset="/brand/logo-dark.svg" media="(prefers-color-scheme: dark)" />
  <img src="/brand/logo-primary.svg" alt="" width="1345" height="1110" />
</picture>

<style>
  /* Sized from the surrounding type, not a fixed pixel width, so the hand
     stays in proportion to whatever wordmark sits next to it. 1.2em puts its
     height a little over the cap height of the text beside it. */
  .brand-mark { display: block; flex: none; height: var(--mark-size, 1.2em); }
  .brand-mark img { display: block; height: 100%; width: auto; }
</style>
