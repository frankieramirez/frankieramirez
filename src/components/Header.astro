---
import BrandMark from "@/components/BrandMark.astro";
const navLinks = [
  { href: "/#work", label: "Work" },
  { href: "/#approach", label: "Approach" },
  { href: "/blog/", label: "Blog" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Frankie Ramirez home">
      <BrandMark />
      <span>frankie ramirez</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {navLinks.map((link) => <a href={link.href} aria-current={Astro.url.pathname === link.href ? "page" : undefined}>{link.label}</a>)}
    </nav>
  </div>
</header>
