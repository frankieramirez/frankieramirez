---
import BrandMark from "@/components/BrandMark.astro";
const navLinks = [
  { href: "/#work", label: "Work" },
  { href: "/#judgment", label: "Judgment" },
  { href: "/blog/", label: "Blog" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Frankie Ramirez home">
      <BrandMark />
      <span>frankie<span class="brand-sep">/</span>ramirez</span>
    </a>

    {/* Email precedes the nav in the DOM because that is its visual order under
        860px, where the nav wraps to a second row. The grid columns below put
        it back on the right on wide screens. */}
    <a class="header-contact" href="mailto:hello@frankieramirez.com">Email</a>

    <nav class="site-nav" aria-label="Primary">
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>
