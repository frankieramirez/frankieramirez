---
import Section from "@/components/Section.astro";
const principles = [
  {
    title: "Make components easy to use correctly",
    body: "I design component APIs so teams can follow shared patterns with fewer special cases. Common tasks should be straightforward, and the API should make constraints clear.",
  },
  {
    title: "Plan accessibility with the interface",
    body: "I include keyboard behavior and focus management in the interface spec, alongside contrast and labels. Leaving accessibility until after design approval makes it easier to cut.",
  },
  {
    title: "Use AI where the work benefits",
    body: "I use AI for migration planning and verification, including repeatable checks during code review. At Luxury Presence, I built validation skills for design-system migrations.",
  },
];
---

<Section label="Approach" id="approach" titleId="approach-title" class="judgment-section">
  <Fragment slot="heading">
    <span id="judgment" aria-hidden="true"></span>
    <h2 id="approach-title">How I work</h2>
  </Fragment>

  <div class="judgment-list">
    {principles.map((principle) => (
      <article class="judgment-item spotlight-panel" data-spotlight>
        <h3>{principle.title}</h3>
        <p>{principle.body}</p>
      </article>
    ))}
  </div>
</Section>
