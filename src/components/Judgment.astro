---
const operatingModel = [
  {
    label: "Primitive Layer",
    detail: "Tokens, states, semantics, accessibility, type",
  },
  {
    label: "Workflow Layer",
    detail: "Routes, data contracts, review flows, eval tasks",
  },
  {
    label: "Adoption Layer",
    detail: "Docs, contribution paths, PR review, release guardrails",
  },
];

const principles = [
  {
    title: "Component APIs Shape Teams",
    body: "A primitive earns its place when correct composition is the easiest thing to do with it. Prop count is a side effect of that, never the goal.",
  },
  {
    title: "Accessibility Is a Product Contract",
    body: "Keyboard flow, focus, contrast, and labels go into the interface spec alongside the visual work. Anything scoped as a cleanup pass after approval tends to get cut.",
  },
  {
    title: "AI Belongs in the Workflow",
    body: "I use AI where it saves real time: critique, verification, migration planning, and the mechanical parts of review that eat human attention.",
  },
];
---

<section class="section judgment-section" id="judgment" aria-labelledby="judgment-title">
  <div class="wrap section-grid">
    <div class="section-label">Judgment</div>
    <div class="section-body">
      <div class="section-heading">
        <h2 id="judgment-title">How I Decide.</h2>
      </div>

      <div class="judgment-list">
        {principles.map((principle) => (
          <article class="judgment-item spotlight-panel" data-spotlight>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
      <section class="judgment-working-model" aria-labelledby="working-model-title">
        <h3 id="working-model-title">Working model</h3>
        <dl>
          {operatingModel.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{row.detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</section>
