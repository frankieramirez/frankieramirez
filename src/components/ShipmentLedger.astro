---
import Section from "@/components/Section.astro";
import { externalAttrs, isExternal } from "@/lib/links";

const rows = [
  {
    status: "Public",
    title: "mana",
    summary:
      "Reusable agent skills for the way I build software. Turns ideas into scoped tickets and carries work through implementation and review, with a fantasy theme that makes the tooling fun to maintain.",
    evidence:
      "Public repository, Claude Code plugin, portable SKILL.md workflows, specialist code reviews, GitHub and Linear tracker support, PR validation and visual proof.",
    links: [
      { label: "Source", href: "https://github.com/frankieramirez/mana" },
      { label: "The Story", href: "/blog/building-my-own-agent-skills/" },
    ],
  },
  {
    status: "Public",
    title: "bushel",
    summary:
      "A terminal UI for Apple Containers. It manages the containers, images, and volumes already on the Mac, and shows the exact command before anything destructive runs.",
    evidence:
      "Public repository, product site, Rust/Ratatui TUI wrapping Apple's container CLI, live telemetry, confirmed destructive actions, Homebrew and shell installers.",
    links: [
      { label: "Site", href: "https://bushel.sh" },
      { label: "Source", href: "https://github.com/frankieramirez/bushel" },
    ],
  },
  {
    status: "Public",
    title: "Ripen",
    summary:
      "Fail-closed image updates for Portainer and Compose. A digest has to mature before it can be applied, and a failed health check rolls the service back and opens the breaker.",
    evidence:
      "Public repository, product site, Go CLI and daemon, digest pinning, no Docker socket, circuit breaker, Git proposals that never self-merge, signed releases.",
    links: [
      { label: "Site", href: "https://ripen.dev" },
      { label: "Source", href: "https://github.com/frankieramirez/ripen" },
    ],
  },
  {
    status: "Public",
    title: "Comicarr",
    summary:
      "A self-hosted app for comic collectors. React UI, with flows designed for people who come back to it every week.",
    evidence: "Public repository, product site, self-hosted product surface, state clarity, type-safe interface work.",
    links: [
      { label: "Site", href: "https://comicarr.com" },
      { label: "Source", href: "https://github.com/frankieramirez/comicarr" },
    ],
  },
  {
    status: "Luxury Presence",
    title: "Design systems & frontend architecture",
    summary:
      "Led the design system from beta toward general availability and owned frontend direction for CRM and Contacts, from component APIs to navigation and saved-search flows.",
    evidence:
      "639+ semantic tokens, a Radix-to-Base UI migration, and snapshot releases with OIDC publishing. Primary frontend contributor on the company’s top product, used by 87,000+ agents.",
    links: [],
  },
  {
    status: "Luxury Presence",
    title: "AI-assisted engineering",
    summary:
      "Introduced Claude Code to the team and built validation skills for design-system migrations. Defined the product architecture for an AI workforce platform and demonstrated AI features to leadership.",
    evidence:
      "The migration skills guarded 6 PRs with 0 fix-ups, compared with 5 fix-ups across the previous 20. An architecture proposal drew on 17 competitive analyses and reduced the platform’s object model from 10 concepts to 5.",
    links: [],
  },
];

const groups = [
  { id: "personal-projects", title: "Personal projects", rows: rows.filter((row) => row.status === "Public") },
  { id: "professional-experience", title: "Professional experience", rows: rows.filter((row) => row.status !== "Public") },
];
---

<Section label="Work" id="work" titleId="work-title" class="ledger-section">
  <Fragment slot="heading">
    <h2 id="work-title">What I Have Shipped.</h2>
    <p>
      Independent projects and the systems I’ve built with product teams.
    </p>
  </Fragment>

  <nav class="work-group-links" aria-label="Work categories">
    {groups.map((group) => <a href={`#${group.id}`}>{group.title} ↓</a>)}
  </nav>
  {groups.map((group) => (
  <section class="work-group" id={group.id} tabindex="-1" aria-labelledby={`${group.id}-title`}>
  <h3 class="work-group-title" id={`${group.id}-title`}>{group.title}</h3>
  <ul class="ledger" role="list">
    {group.rows.map((row) => (
      <li class="ledger-row spotlight-panel" data-spotlight>
        <div class="ledger-status">{row.status}</div>
        <div class="ledger-main">
          <h4>{row.title}</h4>
          <p>{row.summary}</p>
        </div>
        <div class="ledger-evidence">
          <span>Evidence</span>
          <p>{row.evidence}</p>
        </div>
        {row.links.length > 0 && (
          <ul class="ledger-links" role="list">
            {row.links.map((link) => (
              <li>
                <a href={link.href} {...externalAttrs(link.href)}>
                  {link.label}
                  <span class="visually-hidden">
                    {` — ${row.title}`}
                    {isExternal(link.href) && " (opens in a new tab)"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  </section>
  ))}
</Section>
