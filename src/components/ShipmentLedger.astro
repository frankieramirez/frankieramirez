---
import Section from "@/components/Section.astro";
import { externalAttrs, isExternal } from "@/lib/links";

const rows = [
  {
    status: "Public",
    title: "Ultima",
    summary:
      "An open-source design system for React, built with Base UI and StyleX. Components install directly into your project as source you own.",
    evidence:
      "Shared design tokens with light and dark themes, plus agent guidance and a CLI for checking setup and tracking changes to installed components.",
    links: [
      { label: "Visit site", href: "https://ultima.systems" },
      { label: "GitHub", href: "https://github.com/frankieramirez/ultima" },
    ],
  },
  {
    status: "Public",
    title: "mana",
    summary:
      "Agent skills I use to plan and build software, with workflows for implementation and review. The fantasy theme makes them fun to maintain.",
    evidence:
      "Portable SKILL.md workflows with specialist code reviews and support for GitHub and Linear. Available as a Claude Code plugin.",
    links: [
      { label: "GitHub", href: "https://github.com/frankieramirez/mana" },
      { label: "How I built it", href: "/blog/building-my-own-agent-skills/" },
    ],
  },
  {
    status: "Public",
    title: "bushel",
    summary:
      "A terminal UI for Apple Containers. It manages the containers, images, and volumes already on the Mac, and shows the exact command before anything destructive runs.",
    evidence:
      "Built with Rust and Ratatui around Apple’s container CLI, with live telemetry. Install through Homebrew or the shell installer.",
    links: [
      { label: "Visit site", href: "https://bushel.sh" },
      { label: "GitHub", href: "https://github.com/frankieramirez/bushel" },
    ],
  },
  {
    status: "Public",
    title: "Ripen",
    summary:
      "Controlled container updates for Portainer and Compose. Ripen waits for an image to reach a minimum age before updating a service, then rolls back if health checks fail.",
    evidence:
      "A Go CLI and daemon with signed releases. Pins updates to specific image digests and can propose changes through Git for review.",
    links: [
      { label: "Visit site", href: "https://ripen.dev" },
      { label: "GitHub", href: "https://github.com/frankieramirez/ripen" },
    ],
  },
  {
    status: "Public",
    title: "Comicarr",
    summary:
      "A self-hosted app for comic and manga collectors. Tracks new releases and organizes downloaded issues into a personal library.",
    evidence: "A React interface with filters for reading progress and series status, plus a weekly pull list for new releases.",
    links: [
      { label: "Visit site", href: "https://comicarr.com" },
      { label: "GitHub", href: "https://github.com/frankieramirez/comicarr" },
    ],
  },
  {
    status: "Luxury Presence",
    title: "Design systems & frontend architecture",
    summary:
      "Led the design system from beta toward general availability and owned frontend architecture for CRM and Contacts. The work covered component APIs, navigation, and saved-search flows.",
    evidence:
      "Primary frontend contributor on the company’s top product. The design-system work included a migration from Radix to Base UI and snapshot releases with OIDC publishing.",
    links: [],
  },
  {
    status: "Luxury Presence",
    title: "AI-assisted engineering",
    summary:
      "Introduced Claude Code to the team and built validation skills for design-system migrations.",
    evidence:
      "Defined the product architecture for an AI workforce platform. The proposal consolidated its object model from 10 concepts to 5, drawing on 17 competitive analyses.",
    links: [],
  },
];

const groups = [
  { id: "professional-experience", title: "Professional experience", rows: rows.filter((row) => row.status !== "Public") },
  { id: "personal-projects", title: "Personal projects", rows: rows.filter((row) => row.status === "Public") },
];
---

<Section label="Work" id="work" titleId="work-title" class="ledger-section">
  <Fragment slot="heading">
    <h2 id="work-title">Selected work</h2>
    <p>
      The systems I’ve built with product teams and the projects I maintain myself.
    </p>
  </Fragment>

  <nav class="work-group-links" aria-label="Work categories">
    {groups.map((group) => <a href={`#${group.id}`}>{group.title} ↓</a>)}
  </nav>
  {groups.map((group) => (
  <section class="work-group" id={group.id} tabindex="-1" aria-labelledby={`${group.id}-title`}>
  <h3 class="work-group-title" id={`${group.id}-title`}>{group.title}</h3>
  <ul class:list={["ledger", { "ledger-projects": group.id === "personal-projects" }]} role="list">
    {group.rows.map((row) => (
      <li class="ledger-row spotlight-panel" data-spotlight>
        {row.status !== "Public" && <div class="ledger-status">{row.status}</div>}
        <div class="ledger-main">
          <h4>{row.title}</h4>
          <p>{row.summary}</p>
        </div>
        <div class="ledger-evidence">
          {row.evidence && <>
            <span>{row.status === "Public" ? "Details" : "Contribution"}</span>
            <p>{row.evidence}</p>
          </>}
        </div>
        {row.links.length > 0 && (
          <ul class="ledger-links" role="list">
            {row.links.map((link) => (
              <li>
                <a href={link.href} {...externalAttrs(link.href)}>
                  {link.label}
                  <span class="visually-hidden">
                    {` — ${row.title}`}
                    {isExternal(link.href) && " (opens in a new tab)"}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  </section>
  ))}
</Section>
