<section class="section ledger-section" id="work" aria-labelledby="work-title">
  <div class="wrap section-grid">
    <div class="section-label">Work</div>
    <div class="section-body">
      <div class="section-heading">
        <h2 id="work-title">What I Have Shipped.</h2>
        <p>
          Public links where they exist. The employer rows have no links, but they keep enough detail to judge the thinking, and every number is real.
        </p>
      </div>

      <ul class="ledger" role="list">
        {rows.map((row) => (
          <li class="ledger-row spotlight-panel" data-spotlight>
            <div class="ledger-status">{row.status}</div>
            <div class="ledger-main">
              <h3>{row.title}</h3>
              <p>{row.summary}</p>
            </div>
            <div class="ledger-evidence">
              <span>Evidence</span>
              <p>{row.evidence}</p>
            </div>
            {row.links.length > 0 && (
              <ul class="ledger-links" role="list">
                {row.links.map((link) => (
                  <li>
                    <a href={link.href} target="_blank" rel="noopener">
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
