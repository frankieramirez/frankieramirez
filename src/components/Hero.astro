---
import { getPublishedPosts } from "@/lib/blog";

const latestPosts = (await getPublishedPosts()).slice(0, 3);

const meta = [
  { label: "Experience", value: "14+ years" },
  { label: "Focus", value: "Frontend architecture" },
  { label: "Edge", value: "AI-assisted engineering" },
];
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker">Staff Software Engineer · Frontend Architecture and Design Systems</p>
      <h1>I keep complex product interfaces coherent as teams grow.</h1>
      <p class="hero-lede">
        I lead frontend architecture and design systems for product teams. The job: a complex interface that stays fast and accessible while more people ship into it every week.
      </p>
    </div>

    <aside class="hero-aside" aria-label="Latest writing and experience">
      <div class="operating-model" data-spotlight>
        <div class="operating-model-inner">
          <div class="operating-model-head">
            <span>Latest writing</span>
            <a class="latest-writing-all" href="/blog/">All posts <span aria-hidden="true">↗</span></a>
          </div>
          {latestPosts.map((post) => (
            <a class="operating-model-row latest-writing-post" href={`/blog/${post.id}/`}>
              <time class="operating-model-label" datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" })}
              </time>
              <p>{post.data.title}</p>
            </a>
          ))}
          {latestPosts.length === 0 && <p class="operating-model-row">New writing is on its way.</p>}
        </div>
      </div>

      <div class="hero-meta">
        {meta.map((item) => (
          <div class="hero-meta-item">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>
    </aside>
  </div>
</section>
