---
import { formatPostDate, getPublishedPosts } from "@/lib/blog";

const latestPosts = await getPublishedPosts({ limit: 3 });

const meta = [
  { label: "Experience", value: "14+ years" },
  { label: "Based in", value: "New Jersey, US" },
];
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker">Frontend architecture &amp; design systems</p>
      <h1>I help teams build complex interfaces that stay consistent as they grow.</h1>
      <p class="hero-lede">
        I lead frontend architecture and design systems, from component APIs to the workflows people use every day. I help teams ship changes while keeping interfaces fast and accessible.
      </p>
      <nav class="hero-actions" aria-label="Introduction">
        <a href="/#work">View my work <span aria-hidden="true">↓</span></a>
        <a href="mailto:hello@frankieramirez.com">Email me</a>
      </nav>
    </div>

    <aside class="hero-aside" aria-label="Latest writing and experience">
      <div class="operating-model" data-spotlight>
        <div class="operating-model-inner">
          <div class="operating-model-head">
            <span>Latest writing</span>
            <a class="latest-writing-all" href="/blog/">All posts</a>
          </div>
          {latestPosts.map((post) => (
            <a class="operating-model-row latest-writing-post" href={`/blog/${post.id}/`}>
              <time class="operating-model-label" datetime={post.data.date.toISOString()}>
                {formatPostDate(post.data.date, "short")}
              </time>
              <p>{post.data.title}</p>
            </a>
          ))}
          {latestPosts.length === 0 && <p class="operating-model-row">New writing is on its way.</p>}
        </div>
      </div>

      <div class="hero-meta">
        {meta.map((item) => (
          <div class="hero-meta-item">
            <span>{item.label}</span>
            <strong>{item.value}</strong>
          </div>
        ))}
      </div>
    </aside>
  </div>
</section>
