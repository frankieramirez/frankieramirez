---
import Section from "@/components/Section.astro";
import { externalAttrs, isExternal } from "@/lib/links";

const primaryLinks = [
  { label: "Email me", value: "hello@frankieramirez.com", href: "mailto:hello@frankieramirez.com" },
  { label: "GitHub", value: "@frankieramirez", href: "https://github.com/frankieramirez" },
  { label: "View resume", value: "PDF", href: "/resume.pdf" },
];
---

<Section label="Contact" id="contact" titleId="contact-title" class="contact-section">
  <Fragment slot="heading">
    <h2 id="contact-title">Get in touch</h2>
    <p>
      If your team needs help with frontend architecture or a growing design system, I’d be glad to hear what you’re working on.
    </p>
  </Fragment>

  <nav class="contact-links" aria-label="Contact">
    {primaryLinks.map((link) => (
      <a href={link.href} {...externalAttrs(link.href)}>
        <span>{link.label}</span>
        <strong>{link.value}</strong>
        {isExternal(link.href) && (
          <span class="visually-hidden">(opens in a new tab)</span>
        )}
      </a>
    ))}
  </nav>
</Section>
